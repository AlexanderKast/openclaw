{
  "extends": "../tsconfig.package-boundary.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist-plugin",
    "noEmit": false,
    "declaration": false,
    "allowImportingTsExtensions": false,
    "noEmitOnError": false
  },
  "include": ["./*.ts", "./src/**/*.ts", "./legacy/**/*.ts"],
  "exclude": [
    "./**/*.test.ts",
    "./dist/**",
    "./dist-plugin/**",
    "./node_modules/**"
  ]
}
